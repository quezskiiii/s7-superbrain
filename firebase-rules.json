{"rules":{"$other":{".read":false,".write":false},"orders":{"$orderId":{"$other":{".validate":true},".validate":"newData.hasChildren(['id', 'status', 'pin', 'total', 'driverPay', 'miles', 'createdAt'])",".write":"!data.exists() || data.child('status').val() !== 'delivered'","createdAt":{".validate":"newData.isNumber()"},"driverPay":{".validate":"newData.isNumber() && newData.val() >= 0"},"id":{".validate":"newData.isString() && newData.val() === $orderId"},"miles":{".validate":"newData.isNumber() && newData.val() >= 0"},"pin":{".validate":"newData.isString() && newData.val().matches(/^[0-9]{4}$/)"},"status":{".validate":"newData.isString() && newData.val().matches(/^(placed|assigned|picked_up|delivered|cancelled)$/)"},"total":{".validate":"newData.isNumber() && newData.val() >= 0"}},".read":true}}}